{
 "id": "advance_design",
 "kind": "mechanism",
 "title": "Chatbot conversation versus a standard attitude scale as a persuasion measure",
 "rationale": "The source placebo arm also chatted with the chatbot, so the 0.64-point shift in support (95% CI [0.37, 0.91]) compares op-ed with placebo, not chatbot with no chatbot. Keyword differences (+0.166 counterargument, +0.267 supportive) may reflect article content echoed back rather than attitude change. A pre-exposure baseline, a no-chat arm and a delayed follow-up separate these.",
 "contribution": "Tests whether a chatbot conversation detects or adds to attitude change measured by a standard scale, using a no-chat comparison and a baseline.",
 "limitations": [
  "Pre-measurement may sensitise respondents and inflate consistency",
  "Attrition at the one-week follow-up may be selective",
  "Anti-spending quotas still give a smaller subgroup",
  "Transcript classifier validity depends on a human-coded validation sample"
 ],
 "design": {
  "title": "Op-ed x chatbot 2x2 with baseline and one-week follow-up",
  "overview": "Respondents report baseline support and certainty. They are randomised to an op-ed against their own position or a placebo article, and independently to a chatbot conversation or a no-chat filler task. Support and certainty are measured again immediately, and support again after about one week. Chat transcripts are coded with a validated classifier.",
  "hypothesis": "The op-ed shifts support toward the op-ed position within each chat condition. The chatbot adds no detectable shift beyond the scale. Counterargument content in chats tracks, but does not replace, the scale change.",
  "primaryOutcome": "Change in support toward the op-ed position (post minus baseline, 1-7 recoded).",
  "comparison": "Op-ed versus placebo within chat and no-chat arms; op-ed x chat interaction; classifier-coded chat content as a predictor of scale change.",
  "population": "US adults on an online panel, with quotas to oversample anti-spending respondents.",
